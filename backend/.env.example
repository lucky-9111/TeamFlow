# Copy to backend/.env and adjust. Never commit the real .env file.

# development | production | test
TEAMFLOW_ENV=development

# SQLite file (relative paths resolve from the backend/ directory)
TEAMFLOW_DATABASE_URL=sqlite:///./data/teamflow.db

# Attachment storage directory (must not be inside a public web root)
TEAMFLOW_UPLOAD_DIR=./data/uploads
TEAMFLOW_MAX_UPLOAD_MB=10

# Sessions
TEAMFLOW_SESSION_IDLE_HOURS=12
TEAMFLOW_SESSION_MAX_DAYS=7
# true in production (requires HTTPS)
TEAMFLOW_COOKIE_SECURE=false

# Login throttling
TEAMFLOW_LOGIN_MAX_FAILURES=5
TEAMFLOW_LOGIN_LOCKOUT_MINUTES=15

# Comma-separated origins allowed by CORS. Leave empty for same-origin deployments
# (the Vite dev server proxies /api, so development needs no CORS either).
TEAMFLOW_CORS_ORIGINS=

TEAMFLOW_LOG_LEVEL=INFO
