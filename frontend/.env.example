# Copy to frontend/.env if you need to change these. Never commit the real .env file.

# Where the Vite dev server forwards /api requests (the FastAPI backend).
VITE_BACKEND_URL=http://127.0.0.1:8000

# Base path the browser uses for API calls. Keep /api/v1 for both dev (proxied) and
# same-origin production deployments.
VITE_API_BASE_URL=/api/v1
